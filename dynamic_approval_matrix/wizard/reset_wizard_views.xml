<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dam_reset_wizard" model="ir.ui.view">
        <field name="name">dam.reset.wizard.form</field>
        <field name="model">dam.reset.wizard</field>
        <field name="arch" type="xml">
            <form string="Reset Approval" create="0" delete="0">
                <group><field name="request_id" options="{'no_open': True}"/><field name="reason" required="1" placeholder="Why does this approval need to restart?"/></group>
                <p>Previous signatures and history are preserved. The next document button click starts again at the first applicable level. This does not change the document's business state.</p>
                <footer><button name="action_reset" type="object" string="Reset Approval" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
</odoo>
