<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dam_approval_wizard" model="ir.ui.view">
        <field name="name">dam.approval.wizard.form</field>
        <field name="model">dam.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Sign Approval" create="0" delete="0">
                <group>
                    <group><field name="document_name"/><field name="button_label"/></group>
                    <group><field name="level"/><field name="approver_name"/></group>
                </group>
                <group><field name="signature" widget="signature" required="1" options="{'full_name': 'approver_name'}"/>
                    <field name="remark" required="1" placeholder="Enter your approval remark..."/>
                </group>
                <footer>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" confirm="Reject this approval? Only an Approval Manager can reset it."/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
