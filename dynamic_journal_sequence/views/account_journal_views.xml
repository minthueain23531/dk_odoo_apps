<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_dynamic_sequence" model="ir.ui.view">
        <field name="name">account.journal.form.dynamic.sequence</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="sequence_format_template_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
