<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_dynamic_journal_sequence" model="ir.ui.view">
        <field name="name">account.move.form.inherit.dynamic.journal.sequence</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="has_custom_sequence_template" invisible="1"/>
                <field name="requires_seq_code" invisible="1"/>
                <field name="seq_code"
                       invisible="not has_custom_sequence_template"
                       required="requires_seq_code"/>
            </xpath>
        </field>
    </record>
</odoo>
