<odoo>
    <record id="view_migration_batch_list" model="ir.ui.view">
        <field name="name">pam.migration.batch.list</field><field name="model">pam.migration.batch</field>
        <field name="arch" type="xml"><list delete="0"><field name="name"/><field name="company_id"/><field name="staged_at"/></list></field>
    </record>
    <record id="view_migration_batch_form" model="ir.ui.view">
        <field name="name">pam.migration.batch.form</field><field name="model">pam.migration.batch</field>
        <field name="arch" type="xml"><form delete="0">
            <header>
                <button name="action_stage" type="object" string="Stage / Refresh Preview" class="btn-primary"/>
                <button name="action_import_configs" type="object" string="Import Inactive Configuration" confirm="Create inactive Dynamic rules from the staged configuration? No business actions will execute."/>
                <button name="action_export_report" type="object" string="Download Report"/>
            </header>
            <sheet>
                <div class="alert alert-warning" role="alert">Stage during a maintenance window on a database copy first. Legacy records do not prove approval decisions. Review evidence before importing a cycle. This tool does not activate rules or switch approval engines.</div>
                <group><field name="name"/><field name="company_id" readonly="staged_at"/><field name="staged_at"/></group>
                <notebook>
                    <page string="Configuration"><field name="config_ids" readonly="1"><list><field name="source_id"/><field name="model_name"/><field name="method_name"/><field name="amount_field"/><field name="rule_id"/></list></field></page>
                    <page string="History Review"><field name="document_ids" readonly="1"><list><field name="model_name"/><field name="res_id"/><field name="method_name"/><field name="target_state"/><field name="verified"/><field name="request_id"/></list></field></page>
                    <page string="Report"><field name="report" nolabel="1"/></page>
                </notebook>
            </sheet>
        </form></field>
    </record>
    <record id="view_migration_config_form" model="ir.ui.view">
        <field name="name">pam.migration.config.form</field><field name="model">pam.migration.config</field>
        <field name="arch" type="xml"><form create="0" delete="0"><sheet>
            <group><field name="batch_id" readonly="1"/><field name="company_id"/><field name="source_id"/><field name="model_name"/>
                <field name="method_name" readonly="rule_id"/><field name="amount_field" readonly="rule_id"/><field name="rule_id"/></group>
            <notebook><page string="Original Matrix"><field name="source_snapshot"/></page><page string="Original Levels"><field name="line_snapshot"/></page></notebook>
        </sheet></form></field>
    </record>
    <record id="view_migration_document_form" model="ir.ui.view">
        <field name="name">pam.migration.document.form</field><field name="model">pam.migration.document</field>
        <field name="arch" type="xml"><form create="0" delete="0">
            <header><button name="action_import" type="object" string="Import Reviewed Cycle" class="btn-primary" invisible="request_id" confirm="Import the verified decisions into Dynamic history? Original business buttons will not execute."/></header>
            <sheet>
                <group><field name="batch_id" readonly="1"/><field name="company_id"/><field name="model_name"/><field name="res_id"/><field name="method_name"/>
                    <field name="config_id" readonly="request_id"/><field name="target_state" readonly="request_id"/><field name="verified" readonly="request_id"/><field name="request_id"/></group>
                <field name="review_note" placeholder="Record how you verified decisions and cycle boundaries." readonly="request_id"/>
                <field name="evidence_ids" readonly="request_id"><list editable="bottom" create="0" delete="0" open_form_view="1">
                    <field name="source_id"/><field name="level"/><field name="actor_id"/><field name="legacy_created_at"/><field name="amount"/><field name="decision"/><field name="remark"/>
                </list></field>
            </sheet>
        </form></field>
    </record>
    <record id="view_migration_evidence_form" model="ir.ui.view">
        <field name="name">pam.migration.evidence.form</field><field name="model">pam.migration.evidence</field>
        <field name="arch" type="xml"><form create="0" delete="0"><sheet>
            <group><field name="document_id" readonly="1"/><field name="source_id"/><field name="level"/><field name="actor_id"/><field name="legacy_created_at"/><field name="amount"/><field name="decision"/><field name="remark"/></group>
            <field name="signature" widget="image"/><field name="source_snapshot"/>
        </sheet></form></field>
    </record>
    <record id="action_migration_batches" model="ir.actions.act_window"><field name="name">Approval Migration</field><field name="res_model">pam.migration.batch</field><field name="view_mode">list,form</field></record>
    <record id="action_migration_configs" model="ir.actions.act_window"><field name="name">Migration Mappings</field><field name="res_model">pam.migration.config</field><field name="view_mode">list,form</field></record>
    <record id="action_migration_documents" model="ir.actions.act_window"><field name="name">Legacy History Review</field><field name="res_model">pam.migration.document</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_migration_root" name="Migration" parent="dynamic_approval_matrix.menu_dam_root" groups="base.group_system" sequence="90"/>
    <menuitem id="menu_migration_batch" name="Migration Batches" parent="menu_migration_root" action="action_migration_batches"/>
    <menuitem id="menu_migration_config" name="Configuration Mappings" parent="menu_migration_root" action="action_migration_configs"/>
    <menuitem id="menu_migration_document" name="Legacy History Review" parent="menu_migration_root" action="action_migration_documents"/>
</odoo>
