<odoo>
    <record id="view_html_domain_format_list" model="ir.ui.view">
        <field name="name">html.domain.format.list</field>
        <field name="model">html.domain.format</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="domain"/>
            </list>
        </field>
    </record>
    <record id="view_html_domain_format_form" model="ir.ui.view">
        <field name="name">html.domain.format.form</field>
        <field name="model">html.domain.format</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="domain"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_html_domain_format" model="ir.actions.act_window">
        <field name="name">Html Domain Format</field>
        <field name="res_model">html.domain.format</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_html_domain_format" name="Html Domain Format"
              parent="html_template_config_menu" action="action_html_domain_format"
              groups="account.group_account_manager" sequence="1"/>
</odoo>
