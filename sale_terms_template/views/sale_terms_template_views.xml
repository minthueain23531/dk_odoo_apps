<odoo>
    <record id="sale_terms_template_list" model="ir.ui.view">
        <field name="name">sale.terms.template.list</field><field name="model">sale.terms.template</field>
        <field name="arch" type="xml"><list>
            <field name="sequence" widget="handle"/><field name="name"/>
            <field name="company_id" groups="base.group_multi_company"/><field name="domain"/>
        </list></field>
    </record>
    <record id="sale_terms_template_form" model="ir.ui.view">
        <field name="name">sale.terms.template.form</field><field name="model">sale.terms.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Standard Sales Terms"/></h1>
                    </div>
                    <group name="template_settings">
                        <group>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group name="matching_conditions" string="Matching Conditions" col="2">
                        <label for="domain"/>
                        <div class="w-100" style="min-width: 0;">
                            <field name="domain" class="w-100 font-monospace"
                                   style="width: 100%; min-width: 0;"
                                   placeholder="[('partner_id.name', '=', 'Min Thu')]"/>
                            <div class="text-muted mt-1">
                                Enter [] for the company default. The lowest sequence wins; put the default last.
                            </div>
                        </div>
                    </group>
                    <separator string="Terms &amp; Conditions"/>
                    <div class="border rounded p-3">
                        <field name="terms_html" widget="html" nolabel="1" class="w-100"
                               placeholder="Write and format your terms and conditions here..."/>
                    </div>
                    <div class="text-muted mt-3">
                        New quotations use the company default. On a saved draft, Apply Terms selects a matching template and replaces the current terms.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sale_terms_template_action" model="ir.actions.act_window">
        <field name="name">Terms Templates</field><field name="res_model">sale.terms.template</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="sale_terms_template_menu" name="Terms Templates" parent="sale.menu_sale_config" action="sale_terms_template_action" sequence="90" groups="sales_team.group_sale_manager"/>
    <record id="sale_order_form_terms_template" model="ir.ui.view">
        <field name="name">sale.order.form.terms.template</field><field name="model">sale.order</field><field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="before">
                <div class="mb-2">
                    <field name="terms_template_id" force_save="1" options="{'no_create': True}"/>
                    <button name="action_apply_terms" type="object" string="Apply Terms" class="btn-secondary ms-2" invisible="state not in ('draft', 'sent')" confirm="Replace the current Terms &amp; Conditions using the matching template?"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
