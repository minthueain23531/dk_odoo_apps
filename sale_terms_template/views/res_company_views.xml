<odoo>
    <record id="res_company_form_sale_terms" model="ir.ui.view">
        <field name="name">res.company.form.sale.terms.template</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="sale_terms_template" string="Sales Terms &amp; Conditions" groups="sales_team.group_sale_manager">
                    <p>Manage company templates under Sales → Configuration → Terms Templates. An empty domain [] provides the default for new quotations.</p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
